# Copy to .env.local and fill in after `anchor deploy` to devnet.
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

NEXT_PUBLIC_LAUNCHPAD_CORE_PROGRAM_ID=
NEXT_PUBLIC_REWARD_VAULT_PROGRAM_ID=
NEXT_PUBLIC_MERKLE_DISTRIBUTOR_PROGRAM_ID=
NEXT_PUBLIC_LAUNCHPAD_TOKEN_MINT=

# Set to true only after the metadata-capable launchpad upgrade is executed.
NEXT_PUBLIC_LAUNCH_METADATA_ENABLED=false

# Optional override for the built-in /airdrop-claims.json manifest; see AIRDROP_CLAIMS.md.
NEXT_PUBLIC_AIRDROP_CLAIMS_URL=
